# Dependencies
node_modules/
packages/*/node_modules/

# pnpm lockfile — pnpm regenerates this from pnpm-workspace.yaml on every
# `pnpm install`. We treat npm's package-lock.json as the source of truth
# (it's what a consuming plugin's auto-bump and the GH Actions release workflow use)
# so the pnpm lockfile is not committed. Obsidian's scorecard scanner
# regenerates it during its own install step.
pnpm-lock.yaml

# Build output
main.js
/hooks/

# Temp + logs
*.tmp-*
*.log

# System / editor
.DS_Store


# TypeScript build output

# npm packaging (#26): `npm run pack` output, and the files each package's
# prepack copies in from the repo root (canonical copies stay at the root).
/artifacts/
packages/*/LICENSE
packages/plugin/styles.css

# local scratch notes
/agy.txt
/warning.txt
