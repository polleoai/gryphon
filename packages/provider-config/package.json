{
  "name": "@gryphon/provider-config",
  "version": "2.4.1",
  "description": "Provider configuration for Gryphon: model catalogs, pricing tables, dropdown options, per-vendor extra-args filter. Pure data + selection layer (cc-switch lesson). No spawning, no streaming, no UI.",
  "private": true,
  "license": "MIT",
  "author": "POLLEO.AI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pricing/openai": {
      "types": "./dist/pricing/openai.d.ts",
      "require": "./dist/pricing/openai.js",
      "default": "./dist/pricing/openai.js"
    },
    "./pricing/google": {
      "types": "./dist/pricing/google.d.ts",
      "require": "./dist/pricing/google.js",
      "default": "./dist/pricing/google.js"
    },
    "./pricing/anthropic": {
      "types": "./dist/pricing/anthropic.d.ts",
      "require": "./dist/pricing/anthropic.js",
      "default": "./dist/pricing/anthropic.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:dist": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test tests/*.test.ts"
  }
}
